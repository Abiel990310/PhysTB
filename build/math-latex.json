{
  "m*v**2/r*r/(q*B*v) = m*v/(q*B)": "\\frac{m v}{B q} = \\frac{m v}{B q}",
  "2*pi*(m*v/(q*B))/v = 2*pi*m/(q*B)": "\\frac{2 \\pi m}{B q} = \\frac{2 \\pi m}{B q}",
  "d/dr (log(r)) = 1/r": "\\frac{d}{d r} \\log{\\left(r \\right)} = \\frac{1}{r}",
  "d/dt (C*E*(1 - exp(-t/(R*C)))) = E*exp(-t/(R*C))/R": "\\frac{\\partial}{\\partial t} C E \\left(1 - e^{- \\frac{t}{C R}}\\right) = \\frac{E e^{- \\frac{t}{C R}}}{R}",
  "lim t->oo (1 - exp(-t/(R*C))) = 1": "\\lim_{t \\to \\infty}\\left(1 - e^{- \\frac{t}{C R}}\\right) = 1",
  "lim t->0 exp(-t/(R*C)) = 1": "\\lim_{t \\to 0} e^{- \\frac{t}{C R}} = 1",
  "1 - exp(-1) = 1 - exp(-1)": "1 - e^{-1} = 1 - e^{-1}",
  "d/dt (Q*exp(-t/(R*C))) = -Q*exp(-t/(R*C))/(R*C)": "\\frac{\\partial}{\\partial t} Q e^{- \\frac{t}{C R}} = - \\frac{Q e^{- \\frac{t}{C R}}}{C R}",
  "d/dq (q**2/(2*C)) = q/C": "\\frac{\\partial}{\\partial q} \\frac{q^{2}}{2 C} = \\frac{q}{C}",
  "lim z->oo z/(z**2 + R**2)**(3/2)*(z**2)= 1": "\\lim_{z \\to \\infty}\\left(\\frac{z^{3}}{\\left(R^{2} + z^{2}\\right)^{\\frac{3}{2}}}\\right) = 1",
  "d/dx (k*q/x) = -k*q/x**2": "\\frac{\\partial}{\\partial x} \\frac{k q}{x} = - \\frac{k q}{x^{2}}",
  "d/dt (a*cos(w*t)) = -a*w*sin(w*t)": "\\frac{\\partial}{\\partial t} a \\cos{\\left(t w \\right)} = - a w \\sin{\\left(t w \\right)}",
  "d/dt (-a*w*sin(w*t)) = -a*w**2*cos(w*t)": "\\frac{\\partial}{\\partial t} \\left(- a w \\sin{\\left(t w \\right)}\\right) = - a w^{2} \\cos{\\left(t w \\right)}",
  "2*pi*sqrt(m/k) = 2*pi*sqrt(m/k)": "2 \\pi \\sqrt{\\frac{m}{k}} = 2 \\pi \\sqrt{\\frac{m}{k}}",
  "d/dx (k*x**2/2) = k*x": "\\frac{\\partial}{\\partial x} \\frac{k x^{2}}{2} = k x",
  "lim x->0 sin(x)/x = 1": "\\lim_{x \\to 0}\\left(\\frac{\\sin{\\left(x \\right)}}{x}\\right) = 1",
  "d/dx sin(x) = cos(x)": "\\frac{d}{d x} \\sin{\\left(x \\right)} = \\cos{\\left(x \\right)}",
  "k*(1/2) = k/2": "\\frac{k}{2} = \\frac{k}{2}",
  "d/dt (3*t**2 - 2*t) = 6*t - 2": "\\frac{d}{d t} \\left(3 t^{2} - 2 t\\right) = 6 t - 2",
  "d/dt (6*t - 2) = 6": "\\frac{d}{d t} \\left(6 t - 2\\right) = 6",
  "int (6*t) dt = 3*t**2": "\\int 6 t\\, dt = 3 t^{2}",
  "int x**2 dx = x**3/3": "\\int x^{2}\\, dx = \\frac{x^{3}}{3}",
  "M/L*(L**3/3) = M*L**2/3": "\\frac{L^{2} M}{3} = \\frac{L^{2} M}{3}",
  "M*L**2/12 + M*(L/2)**2 = M*L**2/3": "\\frac{L^{2} M}{3} = \\frac{L^{2} M}{3}",
  "int F dt = F*t": "\\int F\\, dt = F t",
  "d/dt (m*v) = 0": "\\frac{\\partial}{\\partial t} m v = 0",
  "(m*v + m*0)/(2*m) = v/2": "\\frac{v}{2} = \\frac{v}{2}",
  "int x dx = x**2/2": "\\int x\\, dx = \\frac{x^{2}}{2}",
  "(1*0 + 3*4)/(1 + 3) = 3": "3 = 3",
  "int k*x dx = k*x**2/2": "\\int k x\\, dx = \\frac{k x^{2}}{2}",
  "int m*v dv = m*v**2/2": "\\int m v\\, dv = \\frac{m v^{2}}{2}",
  "d/dv (m*v**2/2) = m*v": "\\frac{\\partial}{\\partial v} \\frac{m v^{2}}{2} = m v",
